{
  "Frontmatter": {
    "scope": "markdown",
    "prefix": "frontmatter",
    "body": [
      "---",
      "pubDatetime: $CURRENT_YEAR-$CURRENT_MONTH-${CURRENT_DATE}T$CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND.000$CURRENT_TIMEZONE_OFFSET",
      "title: $1",
      "draft: ${2|true,false|}",
      "tags:",
      "  - $3",
      "description: $4",
      "---",
    ],
    "description": "插入博客文章头部，默认保存为草稿",
  },
  "Blog Template": {
    "scope": "markdown",
    "prefix": "template",
    "body": [
      "${1:frontmatter}",
      "",
      "${2:记录这次解决了什么问题}",
      "",
      "## ${3:从哪里开始}",
    ],
    "description": "插入文章骨架，在 frontmatter 处触发头部片段",
  },
}
